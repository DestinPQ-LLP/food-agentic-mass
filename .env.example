# Copy to .env (NEVER commit .env). Backend (NestJS) reads these via @nestjs/config.

# ---------- Database ----------
DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_NAME=food_agentic_mass_db
DATABASE_USER=food_agentic_mass_user
DATABASE_PASS=change_me_strong_password
DATABASE_SSL=false

# ---------- Auth ----------
JWT_SECRET=change_me_to_a_long_random_string
JWT_EXPIRES_IN=8h

# ---------- WhatsApp (Meta Cloud API) ----------
WHATSAPP_API_URL=https://graph.facebook.com/v19.0
WHATSAPP_TOKEN=your_meta_token
WHATSAPP_PHONE_ID=your_phone_id

# ---------- Azure (Front Door fronts the storage static website) ----------
AZURE_STORAGE_CONN_STR=DefaultEndpointsProtocol=https;AccountName=foodagenticmasscdn;AccountKey=...;EndpointSuffix=core.windows.net
AZURE_STORAGE_ACCOUNT=foodagenticmasscdn
AZURE_RESOURCE_GROUP=food-agentic-mass-rg
# Classic Azure CDN was retired for new profiles in 2025; we use Azure Front Door Standard.
# The hostname includes a Microsoft-assigned hash; populated by infrastructure/azure-setup.sh.
AZURE_AFD_PROFILE=food-agentic-mass-cdn-profile
AZURE_AFD_ENDPOINT=food-agentic-mass
AZURE_AFD_HOST=food-agentic-mass-<hash>.z01.azurefd.net
AZURE_CDN_ENDPOINT=https://${AZURE_AFD_HOST}

# ---------- AI ----------
OPENAI_API_KEY=your_azure_openai_key
AZURE_OPENAI_ENDPOINT=https://your-openai-resource.openai.azure.com
AZURE_OPENAI_DEPLOYMENT=gpt-4

# ---------- App ----------
PORT=3000
NODE_ENV=development
CORS_ORIGIN=*
